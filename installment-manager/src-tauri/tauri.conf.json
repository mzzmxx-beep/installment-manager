{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "installment-manager",
  "mainBinaryName": "installment-manager",
  "version": "1.2.1",
  "identifier": "com.installmentmanager.app",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwMTUzNTk2QzdDNjMyRTAKUldUZ01zYkhsalVWZ0l6dkRrK0NMWStUYnpjUmlYbUw4aFJJY0lOOEYyQklUdUhGQ2N4WTlYVXQK",
      "endpoints": [
        "https://github.com/mzzmxx-beep/installment-manager/releases/latest/download/latest.json"
      ]
    }
  },
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "installment-manager",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    }
  }
}
